        "params": "biomeId: 'forest' | 'desert' | 'mountain'",
        "returns": "THREE.Group",
        "notes": "Builds 1400x1400m open-world heightmap mesh, surface zones, bridges, caves/tunnels, trees/cacti/boulders, and destructible physics props."
      },
      {
        "name": "createCollectiblePrefab",
        "params": "type: 'crate' | 'relic'",
        "returns": "THREE.Group",
        "notes": "Glowing tactile treasure chest or ancient golden relic with floating animation."
